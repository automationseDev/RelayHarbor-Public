# Generate tokens independently with: python -c "import secrets; print(secrets.token_urlsafe(48))"
RELAY_CLIENT_TOKEN=replace-with-unique-random-token-ONE-at-least-32-chars
RELAY_WEBHOOK_TOKEN=replace-with-unique-random-token-TWO-at-least-32-chars
RELAY_DATABASE=/data/relayharbor.sqlite3

# Configure either or both. These credentials stay ONLY on your server.
# This URL is the Dify API root, ending in /v1 (not /chat-messages).
DIFY_API_URL=
DIFY_API_KEY=
DIFY_USER=relayharbor

OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional background pollers (1 = enabled). Default: enabled.
RELAY_RSS_ENABLED=1
RELAY_WEBSITE_MONITOR_ENABLED=1
